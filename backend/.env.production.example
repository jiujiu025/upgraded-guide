ENVIRONMENT=production
DATABASE_URL=
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=10
REFRESH_SESSION_DAYS=7
SESSION_TOKEN_HASH_KEY=
FRONTEND_ORIGIN=
# 额外跨域来源（逗号分隔，如官网域名），生产必须 https，禁止 localhost 与通配符。
FRONTEND_ORIGINS=
RATE_LIMIT_BACKEND=redis
REDIS_URL=
TRUSTED_PROXY_CIDRS=
LOGIN_RATE_LIMIT=10
REGISTRATION_RATE_LIMIT=5
# 公开只读接口（产品/算价）每 IP 每分钟上限。
PUBLIC_RATE_LIMIT=60
# 代客下单最大折扣（百分比），30 = 最多 7 折；只有管理员能设折扣。
MAX_ORDER_DISCOUNT_PERCENT=30
RATE_LIMIT_WINDOW_SECONDS=60
GLOBAL_PROXY_API_KEY=
# 32 字节 hex（64 字符）。不填则供应商凭据与通知渠道密钥都无法保存（创建渠道返回 400）。
# 生成：python -c "import os;print(os.urandom(32).hex())"
SUPPLIER_SECRET_ENCRYPTION_KEY=
PAYMENT_SECRET_ENCRYPTION_KEY=
# 仅通过本地闭环验收时的线上单笔限额（分）。跑通真实支付并登记 live 验收后失效。
PAYMENT_SANDBOX_MAX_CENTS=10000
GLOBAL_PROXY_BASE_URL=https://admin.quanqiudaili.com
SUPPLIER_HTTP_TIMEOUT_SECONDS=10
SUPPLIER_READ_RETRY_ATTEMPTS=3
SUPPLIER_RETRY_BACKOFF_SECONDS=0.25
SUPPLIER_RETRY_MAX_DELAY_SECONDS=5
# 自动采购强制关闭：该配置项类型固定为 Literal[False]，默认即为 False。
# 不要写成 SUPPLIER_AUTO_PROCUREMENT_ENABLED=false——环境变量是字符串，
# pydantic 不会把它转成布尔，会直接抛 literal_error 导致服务起不来。
# SUPPLIER_AUTO_PROCUREMENT_ENABLED=
SUPPLIER_CATALOG_TTL_MINUTES=1440
SUPPLIER_INVENTORY_TTL_MINUTES=30
SUPPLIER_QUOTE_TTL_MINUTES=1440
SUPPLIER_INVENTORY_BATCH_SIZE=10
SUPPLIER_SNAPSHOT_RETENTION_DAYS=7
